<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!--
   SukiSU：云备份与换机传输**两者都要**排除会话令牌那一份 sharedpref。
   Android 12+ 只认本文件（backup_rules.xml 在这台版本上被忽略），所以两条规则
   少写一条就等于少堵一个出口：云备份堵了、换机传输照样把凭据拷到新设备。

   path 用相对 sharedpref 目录的文件名，与 ModuleUploadPrefs.PREFS_NAME 对应：
   "module_upload_session" → module_upload_session.xml。
-->
    <!--
   安装模块时留存的原始 zip（ModuleZipArchive，filesDir/module_zips/）同样两边都排除：
   上限 256 MB 的安装包塞进云端备份既浪费流量又必然撞配额，而换机后重装模块就会
   重新留存，没有带走的必要。
-->
    <cloud-backup>
        <exclude domain="sharedpref" path="module_upload_session.xml"/>
        <exclude domain="file" path="module_zips/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="module_upload_session.xml"/>
        <exclude domain="file" path="module_zips/"/>
    </device-transfer>
</data-extraction-rules>