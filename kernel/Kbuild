ifeq ($(CONFIG_KPM),y)
# These must be linked into kernelsu.ko too, not standalone obj-y objects.
kernelsu-objs += extension/kpm/kpm.o
kernelsu-objs += extension/kpm/compact.o
kernelsu-objs += extension/kpm/super_access.o

# Vendor backports may change these fields independently of LINUX_VERSION_CODE.
# Inspect the actual target source header, not the host kernel or KMI label.
ksu_netlink_cfg := $(shell sed -n '/struct netlink_kernel_cfg {/,/^};/p' $(srctree)/include/linux/netlink.h)
ifneq ($(findstring cb_mutex,$(ksu_netlink_cfg)),)
ccflags-y += -DKSU_NETLINK_CFG_HAS_CB_MUTEX=1
endif
ifneq ($(findstring compare,$(ksu_netlink_cfg)),)
ccflags-y += -DKSU_NETLINK_CFG_HAS_COMPARE=1
endif
endif
# kpm.c provides the extension glue (ksu_extension_kpm_*), referenced
# unconditionally by extension/extension.c, so build it even when
# CONFIG_KPM is off — its set/get/io become no-ops.
kernelsu-objs += extension/kpm.o

ccflags-y += -I$(srctree)/security/selinux -I$(srctree)/security/selinux/include
ccflags-y += -I$(objtree)/security/selinux -include $(srctree)/include/uapi/asm-generic/errno.h

ifneq ($(KBUILD_EXTMOD),)
# 6.18 exports the external module source as srcroot when M/MO are used.
ifneq ($(srcroot),)
KSU_KERNEL_DIR := $(srcroot)
endif
endif
ifndef KSU_KERNEL_DIR
ifeq ($(filter /%,$(src)),)
KSU_KERNEL_DIR := $(srctree)/$(src)
else
KSU_KERNEL_DIR := $(src)
endif
endif

ccflags-y += -I$(KSU_KERNEL_DIR) -I$(KSU_KERNEL_DIR)/include

# preinit runner: a static nolibc binary embedded into kernelsu, see preinit/.
# It is built against the installed UAPI headers of the target kernel
# (CONFIG_HEADERS_INSTALL, enabled by gki_defconfig).
KSU_UAPI_INC := $(objtree)/usr/include
ifneq ($(wildcard $(KSU_UAPI_INC)/linux/unistd.h),)
kernelsu-objs += preinit/preinit.o
kernelsu-objs += preinit/blob.o

KSU_RUNNER_CFLAGS := $(CLANG_FLAGS) -std=gnu11 -Os -Wall \
	-nostdinc -isystem $(shell $(CC) -print-file-name=include) \
	-I$(KSU_KERNEL_DIR)/preinit/runner/nolibc -I$(KSU_UAPI_INC) \
	-I$(KSU_KERNEL_DIR)/include \
	-ffreestanding -fno-stack-protector -fno-pic -fno-pie \
	-fno-asynchronous-unwind-tables -fno-unwind-tables \
	-ffunction-sections -fdata-sections

quiet_cmd_ksu_runner = RUNNER  $@
      cmd_ksu_runner = $(CC) $(KSU_RUNNER_CFLAGS) -c -o $@.o $< && \
		$(LD) -static -nostdlib -e _start --gc-sections -s -o $@ $@.o && \
		rm -f $@.o

$(obj)/preinit/runner.elf: $(KSU_KERNEL_DIR)/preinit/runner/runner.c \
		$(wildcard $(KSU_KERNEL_DIR)/preinit/runner/nolibc/*.h \
			   $(KSU_KERNEL_DIR)/preinit/runner/nolibc/sys/*.h \
			   $(KSU_KERNEL_DIR)/include/uapi/*.h) FORCE
	$(call if_changed,ksu_runner)

targets += preinit/runner.elf
$(obj)/preinit/blob.o: $(obj)/preinit/runner.elf
asflags-y += -DKSU_PREINIT_RUNNER_BIN=\"$(obj)/preinit/runner.elf\"
else
$(warning -- KernelSU: $(KSU_UAPI_INC) not found, preinit disabled)
ccflags-y += -DKSU_NO_PREINIT
endif

obj-$(CONFIG_KSU) += kernelsu.o

MDIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))

REPO_OWNER  := SukiSU-Ultra
REPO_NAME   := SukiSU-Ultra
# 仅在「既没有 .git、CI 又没传 KSU_VERSION」时用于回退数 GitHub 的 main 分支。
# 本仓库发版分支是 custom-repo-backup，main 会比它少一批提交；数 main 得到的
# 版本号必然小于 manager 的 versionCode，首页就会永久显示「有可用更新」。
# 用 ?= 允许 make/环境覆盖，正常构建路径请走 KSU_VERSION 注入。
REPO_BRANCH ?= main

VERSION_BASE    := 40000
VERSION_OFFSET  := 2815

GIT_BIN  := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin git
CURL_BIN := /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin curl

KSU_SRC := $(if $(filter $(srctree),$(src)),$(src),$(srctree)/$(src))
KSU_SRC := $(if $(wildcard $(KSU_SRC)/../.git),$(KSU_SRC),$(MDIR))

git_short_sha    = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --short=8 HEAD 2>/dev/null)
# 分支名允许 KSU_BUILD_REF 覆盖：发布构建是 detached HEAD，rev-parse 只会得到
# "HEAD"，上游 workflow 因此在 release 构建里显式传 KSU_BUILD_REF=release。
git_branch       = $(if $(strip $(KSU_BUILD_REF)),$(KSU_BUILD_REF),$(shell cd $(KSU_SRC) && $(GIT_BIN) rev-parse --abbrev-ref HEAD 2>/dev/null))
# 提交数固定数本地 HEAD（上游数 $(REPO_BRANCH)=main）：本仓库发版 tag 打在 ci 分支上，
# 数 main 会得到偏小且与管理器不一致的版本号。
git_commit_count = $(shell cd $(KSU_SRC) && $(GIT_BIN) rev-list --count HEAD 2>/dev/null)
git_latest_tag   = $(shell cd $(KSU_SRC) && $(GIT_BIN) describe --tags --abbrev=0 2>/dev/null | sed 's/^v//')

$(shell cd $(KSU_SRC) 2>/dev/null && [ -f ../.git/shallow ] && $(GIT_BIN) fetch --unshallow 2>/dev/null)

GITHUB_API_BASE  := https://api.github.com/repos/$(REPO_OWNER)/$(REPO_NAME)
KSU_GITHUB_VER   := $(shell $(CURL_BIN) -s "$(GITHUB_API_BASE)/releases/latest" 2>/dev/null | grep '"tag_name":' | sed -E 's/.*"v?([^"]+)".*/\1/')
GITHUB_COMMITS   := $(shell $(CURL_BIN) -sI "$(GITHUB_API_BASE)/commits?sha=$(REPO_BRANCH)&per_page=1" 2>/dev/null | grep -i "link:" | sed -n 's/.*page=\([0-9]*\)>; rel="last".*/\1/p')
# 提交数优先取本地 HEAD（与管理器 getVersionCode 的 git rev-list --count HEAD
# 同源同式，同一 commit 编出的内核与管理器版本号必然一致）；仅在无 .git 的
# tarball 构建下才回退到 GitHub API 查上游 main。
LOCAL_COUNT     := $(if $(git_commit_count),$(git_commit_count),$(GITHUB_COMMITS))
KSU_VERSION     := $(if $(LOCAL_COUNT),$(shell expr $(VERSION_BASE) + $(LOCAL_COUNT) - $(VERSION_OFFSET)),$(VERSION_BASE))
VERSION_TAG     := $(or $(KSU_GITHUB_VER),$(git_latest_tag),4.2.1)
KSU_VERSION_FULL := $(if $(call git_short_sha),v$(VERSION_TAG)-$(call git_short_sha)@$(call git_branch),v$(VERSION_TAG)-$(REPO_NAME)-unknown@unknown)
$(info -- $(REPO_NAME) version: $(KSU_VERSION) [$(KSU_VERSION_FULL)])

ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
ccflags-y += -DKSU_VERSION_FULL=\"$(KSU_VERSION_FULL)\"

# 管理器包名不再在这里写字面量：默认值来自仓库根的 manager-package.properties
# （单一真源），KSU_IS_PR_BUILD 的默认值与 PR 分支的选择也在 manager-package.mk 里。
# 命令行传 KSU_PACKAGE_NAME=... 仍然优先。详见 kernel/manager-package.mk。
include $(dir $(lastword $(MAKEFILE_LIST)))manager-package.mk

KSU_EXPECTED_SIZE ?= 0x35c
KSU_EXPECTED_HASH ?= 947ae944f3de4ed4c21a7e4f7953ecf351bfa2b36239da37a34111ad29993eef

$(info -- KernelSU Manager package name: $(KSU_PACKAGE_NAME))
$(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
$(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))
$(info -- KernelSU is PR Build: $(KSU_IS_PR_BUILD))

ccflags-y += -DKSU_PACKAGE_NAME=\"$(KSU_PACKAGE_NAME)\"
ccflags-y += -DEXPECTED_SIZE=$(KSU_EXPECTED_SIZE)
ccflags-y += -DEXPECTED_HASH=\"$(KSU_EXPECTED_HASH)\"
ccflags-y += -DKSU_IS_PR_BUILD=$(KSU_IS_PR_BUILD)

KERNEL_VERSION := $(VERSION).$(PATCHLEVEL)
KERNEL_TYPE := Non-GKI
# Check for GKI 2.0 (5.10+ or 6.x+)
ifneq ($(shell test \( $(VERSION) -ge 5 -a $(PATCHLEVEL) -ge 10 \) -o $(VERSION) -ge 6; echo $$?),0)
# Check for GKI 1.0 (5.4)
ifeq ($(shell test $(VERSION)-$(PATCHLEVEL) = 5-4; echo $$?),0)
KERNEL_TYPE := GKI 1.0
endif
else
KERNEL_TYPE := GKI 2.0
endif
$(info -- KERNEL_VERSION: $(KERNEL_VERSION))
$(info -- KERNEL_TYPE: $(KERNEL_TYPE))

ifeq ($(CONFIG_KPM), y)
$(info -- KPM is enabled)
else
$(info -- KPM is disabled)
endif

KSU_NEW_DCACHE_FLUSH := $(shell grep -q __flush_dcache_area $(srctree)/arch/arm64/include/asm/cacheflush.h ; echo $$?)
$(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))

# Check new vfs_getattr()
ifeq ($(shell grep -A1 "^int vfs_getattr" $(srctree)/fs/stat.c | grep -q "query_flags" ; echo $$?),0)
ccflags-y += -DKSU_HAS_NEW_VFS_GETATTR
endif

# Function proc_ops check
ifeq ($(shell grep -q "struct proc_ops " $(srctree)/include/linux/proc_fs.h; echo $$?),0)
ccflags-y += -DKSU_COMPAT_HAS_PROC_OPS
endif

# 第二签名槽（fork 自有，上游 2dedd26b #987 删过这一段）：槽 1 是官方证书、槽 2 是 fork 证书，
# 两边刷完内核都开箱被认成管理器。上游换成的运行时动态授权名单补不了这一步——它要求设备上已经
# 有一个能取到 root 的管理器，而 fork 的 APK 用的是自己的证书、走的正是槽 2。三条 workflow
# 仍在透传这两个变量（build-lkm/ddk-lkm 的 EXTRA_ARGS、build-manager 用 secrets.KEYSTORE 填槽 2），
# 少了下面这段它们会安静地变成空传：apk_sign.c 的 #ifdef 不成立，编译与打包都不报错。
ifdef KSU_EXPECTED_SIZE2
ifndef KSU_EXPECTED_HASH2
$(error KSU_EXPECTED_HASH2 must be set when KSU_EXPECTED_SIZE2 is set)
endif
ccflags-y += -DEXPECTED_SIZE2=$(KSU_EXPECTED_SIZE2)
ccflags-y += -DEXPECTED_HASH2=\"$(KSU_EXPECTED_HASH2)\"
$(info -- KernelSU Manager signature size2: $(KSU_EXPECTED_SIZE2))
$(info -- KernelSU Manager signature hash2: $(KSU_EXPECTED_HASH2))
endif

ccflags-y += -DKSU_NEW_DCACHE_FLUSH=$(KSU_NEW_DCACHE_FLUSH)

ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-missing-prototypes
ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

